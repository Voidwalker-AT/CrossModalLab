{
  "schema_version": "phase_2i_b_es_ablation_v1",
  "status": "FROZEN_BEFORE_OUTCOMES",
  "description": "Matched CE+ES vs CE-only ablation; ES coefficient pre-registered",
  "base_protocol": "configs/phase_2i_a/ce_control_protocol_v1.json",
  "change_from_2i_a": "add evidence_sufficiency term only",
  "es_objective": {
    "mode": "margin",
    "margin": 1.0,
    "mu_es": 0.25,
    "ce_weight": 1.0,
    "class_scores": "summed_candidate_sequence_log_likelihood",
    "length_normalized": false,
    "candidates": [" Yes", " No", " Undetermined"],
    "abstain_index": 2,
    "sufficiency_from_gold": "0 if Undetermined else 1",
    "anti_over_abstention": true
  },
  "matched_to_2i_a": {
    "seed": 20261111,
    "max_steps": 50,
    "sanity_steps": 5,
    "lora_r": 2,
    "lora_alpha": 4,
    "optimizer": "AdamW",
    "learning_rate": 0.0001,
    "sampling": "maximize_family_coverage_balanced_classes",
    "masking": "gold_answer_span_suffix",
    "parser": "strict_answer_v1",
    "eval_families_rule": "freeze_val_ids n=6 validation split",
    "holdout_allowed": false
  },
  "no_tuning_on_val": true
}
