# CrossModalLab local environment template
# Copy to `.env` (gitignored) or export these variables in your shell.
# Do not commit real tokens. Hugging Face tokens are optional for public models
# already present in a local cache.

# --- Path overrides (optional) ---
# Primary machine keeps using the existing E: cache automatically when present.
# CROSSMODAL_HF_HOME=E:/cache/huggingface
# CROSSMODAL_TEMP_DIR=E:/cache/temp
# CROSSMODAL_LEGACY_E_CACHE=1

# Explicit snapshot override if your HF cache layout differs:
# CROSSMODAL_MODEL_SNAPSHOT_DIR=/path/to/models--HuggingFaceTB--SmolVLM2-2.2B-Instruct/snapshots/482adb537c021c86670beed01cd58990d01e72e4

# Artifact/dataset roots (defaults are repository-relative):
# CROSSMODAL_ARTIFACTS_DIR=/path/to/artifacts
# CROSSMODAL_DATASETS_DIR=/path/to/datasets

# Standard Hugging Face variables (honored if already set):
# HF_HOME=/path/to/huggingface
# HF_HUB_CACHE=/path/to/huggingface/hub
# HUGGING_FACE_HUB_TOKEN=

# --- Notes ---
# 1. On the primary developer machine, leave CROSSMODAL_* unset to preserve
#    the existing E:/cache/huggingface model weights (no redownload).
# 2. On other machines, either set HF_HOME or allow the default ~/.cache/huggingface.
# 3. Do not put credentials in configs/experiment_config.json.
